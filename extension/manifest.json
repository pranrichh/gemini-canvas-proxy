{
    "manifest_version": 3,
    "name": "Gemini Canvas Proxy Bridge",
    "version": "2.0.0",
    "description": "Relays requests from a local OpenAI-compatible endpoint to a Gemini Canvas page over a private MessageChannel.",
    "minimum_chrome_version": "120",
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "nativeMessaging"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://gemini.google.com/*"],
            "js": ["content_script.js"],
            "run_at": "document_start",
            "all_frames": true
        }
    ]
}
