{
    "manifest_version": 3,
    "name": "Gemini Canvas Proxy Bridge",
    "version": "2.0.0",
    "description": "Relays requests from a local OpenAI-compatible endpoint to a Gemini Canvas page over a private MessageChannel.",
    "minimum_chrome_version": "120",
    "permissions": [
        "alarms",
        "storage",
        "tabs",
        "nativeMessaging"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "content_script.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "icons": {
        "16": "icons/16.png",
        "32": "icons/32.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "action": {
        "default_title": "Gemini Canvas Proxy",
        "default_icon": {
            "16": "icons/16.png",
            "32": "icons/32.png"
        }
    }
}
